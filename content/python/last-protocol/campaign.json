            "question": "Which Python statement correctly outputs the exact string 'PROTOCOL_READY' to standard output without syntax errors?",
            "conceptReminder": "Python strings must be enclosed in matching quotes (single or double) and passed as arguments to print().",
            "options": [
              {
                "id": "opt-1",
                "text": "print(PROTOCOL_READY)",
                "isCorrect": false,
                "explanation": "Without quotes, Python interprets PROTOCOL_READY as an unassigned variable and raises a NameError."
              },
              {
                "id": "opt-2",
                "text": "print('PROTOCOL_READY')",
                "isCorrect": true,
                "explanation": "Correct! Enclosing the text in single quotes defines a valid string literal passed to the print() function."
              },
              {
                "id": "opt-3",
                "text": "output 'PROTOCOL_READY'",
                "isCorrect": false,
                "explanation": "'output' is not a valid Python keyword; Python standard output is invoked via print()."
              }
            ]
