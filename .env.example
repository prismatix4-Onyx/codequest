# =======================================================
# CODEQUEST 2.0 — Production Environment Configuration
# =======================================================

# -------------------------------------------------------
# 1. Frontend (Vercel)
# -------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=https://codequest-api.onrender.com/api/v1
NEXT_PUBLIC_VOICE_SERVICE_URL=https://codequest-voice.onrender.com
NEXT_PUBLIC_APP_ENV=production
NEXT_IGNORE_INCORRECT_LOCKFILE=1

# -------------------------------------------------------
# 2. Database & Auth (Supabase PostgreSQL - 100% Free)
# -------------------------------------------------------
# Transaction-mode connection string (port 6543) for NestJS runtime:
DATABASE_URL=postgresql://postgres.ysfrvdusuzrjiqnbmfxm:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct-mode connection string (port 5432) for Prisma migrations / db push:
DIRECT_URL=postgresql://postgres.ysfrvdusuzrjiqnbmfxm:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# -------------------------------------------------------
# 3. Audio & Media Storage (Supabase Storage - No Credit Card)
# -------------------------------------------------------
SUPABASE_URL=https://ysfrvdusuzrjiqnbmfxm.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_BUCKET=codequest-assets

# -------------------------------------------------------
# 4. Backend API (Render Web Service)
# -------------------------------------------------------
API_PORT=10000
JWT_SECRET=super-secret-codequest-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=7d
EXECUTION_WORKER_URL=https://codequest-worker.onrender.com/execute
VOICE_SERVICE_URL=https://codequest-voice.onrender.com

# -------------------------------------------------------
# 5. Voice Microservice (Edge-TTS on Render)
# -------------------------------------------------------
VOICE_SERVICE_PORT=8001
VOICE_CACHE_DIR=./cache/audio
DEFAULT_VOICE_ARIA=en-US-AriaNeural
DEFAULT_VOICE_KAEL=en-US-GuyNeural

# -------------------------------------------------------
# 6. Python Execution Sandbox Worker (Render)
# -------------------------------------------------------
EXECUTION_PORT=8002
EXECUTION_TIMEOUT_SECONDS=4
EXECUTION_MAX_MEMORY_MB=128
EXECUTION_MAX_OUTPUT_CHARS=50000
